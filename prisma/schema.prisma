generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
model Link {
  id          Int       @id @default(autoincrement())
  title       String
  titleES     String?
  url         String
  icon        String?
  category    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
   imageUrl    String?
  authorName  String?
   linkType           String   @default("general") // "general" | "article" | "edition"
  editionNumber      Int?
  editionCoverImage  String?
}
model Article {
  id                Int               @id @default(autoincrement())
  title             String
  content           String            @db.LongText
  beitragstypId     Int
  beitragssubtypId  Int?
  editionId         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isInPrintEdition  Boolean           @default(false)
  endPage           Int?
  startPage         Int?
  subtitle          String?
  isPublished       Boolean           @default(false)
  publicationDate   DateTime?
  previewText       String?           @db.LongText
  additionalInfo    String?           @db.Text
  bookImage         String?
  mediaTitle        String?           @db.Text
  articleImage      String?           @db.Text
  beitragsId        Int?
  isTranslatedES    Boolean           @default(false)
  additionalInfoES  String?           @db.Text
  contentES         String?           @db.LongText
  previewTextES     String?           @db.LongText
  titleES           String?
  subtitleES        String?
  needsReviewES     Boolean           @default(false)
  editedAfterReview Boolean           @default(false)
  frontpagePriority Int               @default(0)
  legacyPath        String?           @unique
  reviewerId        String?
  translatorId      String?
  assignedAt        DateTime?
  translationStatus String            @default("not_assigned")
  reviewedAt        DateTime?
  activityLogs      ActivityLog[]
  pdfs              ArticlePdf[]
  beitragssubtyp    Beitragssubtyp?   @relation(fields: [beitragssubtypId], references: [id])
  beitragstyp       Beitragstyp       @relation(fields: [beitragstypId], references: [id])
  edition           Edition?          @relation(fields: [editionId], references: [id])
  reviewer          User?             @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  translator        User?             @relation("ArticleTranslator", fields: [translatorId], references: [id])
  carouselArticles  CarouselArticle[]
  favorites         Favorite[]
  obituaryDetails   ObituaryDetails?
  tocManualMatches  TocManualMatch[]
  authors           Author[]          @relation("ArticleAuthors")
  categories        Category[]        @relation("ArticleCategories")
  interviewees      Interviewee[]     @relation("ArticleInterviewees")
  regions           Region[]          @relation("ArticleRegions")
  topics            Topic[]           @relation("ArticleTopics")

  @@index([beitragssubtypId], map: "Article_beitragssubtypId_fkey")
  @@index([beitragstypId], map: "Article_beitragstypId_fkey")
  @@index([editionId], map: "Article_editionId_fkey")
  @@index([reviewerId], map: "Article_reviewerId_fkey")
  @@index([translatorId], map: "Article_translatorId_fkey")
}

model ArticlePdf {
  id        Int      @id @default(autoincrement())
  articleId Int
  url       String   @db.Text
  title     String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Interviewee {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[] @relation("ArticleInterviewees")
}

model Aktuelles {
  id          Int      @id @default(autoincrement())
  title       String
  titleES     String?
  subtitle    String?
  subtitleES  String?
  content     String   @db.Text
  contentES   String?  @db.Text
  date        DateTime @default(now())
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "Aktuelles_createdById_fkey")
}

model Edition {
  id                 Int              @id @default(autoincrement())
  number             Int              @unique
  title              String
  createdAt          DateTime         @default(now())
  datePublished      DateTime         @default(now())
  subtitle           String?
  summary            String           @db.Text
  isCurrent          Boolean          @default(false)
  tableOfContents    String?          @db.Text
  backgroundImage    String?
  coverImage         String?
  isAvailableToOrder Boolean?
  drupalId           Int?
  titleES            String?
  isSpecialOffer     Boolean          @default(false)
  isReprint          Boolean          @default(false)
  isTranslatedES     Boolean          @default(false)
  subtitleES         String?
  summaryES          String?          @db.Text
  tableOfContentsES  String?          @db.Text
  assignedAt         DateTime?
  needsReviewES      Boolean          @default(false)
  reviewedAt         DateTime?
  translationStatus  String           @default("not_assigned")
  translatorId       String?
  activityLogs       ActivityLog[]
  articles           Article[]
  translator         User?            @relation("EditionTranslator", fields: [translatorId], references: [id])
  orderItems         OrderItem[]
  tocManualMatches   TocManualMatch[]
  regions            Region[]         @relation("EditionRegions")
  topics             Topic[]          @relation("EditionTopics")
  pdf               EditionPdf?

  @@index([translatorId])
}

model EditionPdf {
  id          String    @id @default(cuid())
  editionId   Int       @unique
  pdfUrl      String
  fileSize    Int?
  pageCount   Int?
  uploadedAt  DateTime  @default(now())
  
  edition     Edition   @relation(fields: [editionId], references: [id])
}
model AnnualIndex {
  id         String   @id @default(cuid())
  year       Int      @unique
  title      String?  // Optional: "Annual Index 2026"
  titleES    String?  // Spanish title
  fileUrl    String   // /uploads/annual-index/Register-2026.pdf
  fileName   String   // Register-2026.pdf
  fileSize   Int?     // In bytes
  uploadedAt DateTime @default(now())
  uploadedBy String?  // Admin user ID
  
  @@map("annual_index")
}

model PdfAboInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  isRedeemed  Boolean   @default(false)
  redeemedAt  DateTime?
  redeemedBy  String?   @unique  // ← Añade @unique aquí
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  
  user        User?     @relation(fields: [redeemedBy], references: [id])
}
model Banner {
  id            String   @id @default(cuid())
  title         String
  titleEs       String?
  subtitle      String   @db.Text
  subtitleEs    String?  @db.Text
  description   String   @db.Text
  descriptionEs String?  @db.Text
  buttonText    String
  buttonTextEs  String?
  buttonUrl     String
  imageUrl      String?
  
  // 🎨 Personalización visual
  bgGradientFrom    String @default("#dc2626") // red-600
  bgGradientTo      String @default("#b91c1c") // red-700
  titleSize         String @default("sm")      // xs, sm, md, lg
  subtitleSize      String @default("3xl")     // xl, 2xl, 3xl, 4xl
  descriptionSize   String @default("base")    // sm, base, lg
  buttonColor       String @default("#dc2626") // red-600
  hasPromoForm      Boolean @default(false) 
  
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  position      String   @default("top")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("banners")
}

model Order {
  id           String           @id @default(uuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  salutation   String?
  firstName    String
  lastName     String
  institution  String?
  street       String
  addressExtra String?
  zip          String
  city         String
  country      String
  phone        String?
  email        String
  message      String?
  isNew        Boolean          @default(true)
  items        OrderItem[]
  recipients   OrderRecipient[]
}

model OrderRecipient {
  id           String      @id @default(uuid())
  orderId      String
  salutation   String?
  firstName    String
  lastName     String
  institution  String?
  street       String
  addressExtra String?
  zip          String
  city         String
  country      String
  phone        String?
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([orderId], map: "OrderRecipient_orderId_fkey")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  editionId   Int
  qty         Int             @default(1)
  recipientId String?
  edition     Edition         @relation(fields: [editionId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipient   OrderRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([editionId], map: "OrderItem_editionId_fkey")
  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([recipientId], map: "OrderItem_recipientId_fkey")
}

model Subscription {
  id                        String                    @id @default(uuid())
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  type                      SubscriptionType
  format                    SubscriptionFormat
  donationExtra             Float?
  isGift                    Boolean                   @default(false)
  startYear                 Int                       @default(2025)
  salutation                String?
  firstName                 String
  lastName                  String
  institution               String?
  street                    String
  addressExtra              String?
  zip                       String
  city                      String
  country                   String
  phone                     String?
  email                     String
  message                   String?
  giftRecipientName         String?
  giftRecipientEmail        String?
  giftRecipientStreet       String?
  giftRecipientZip          String?
  giftRecipientCity         String?
  giftRecipientCountry      String?
  giftId                    String?
  termsAccepted             Boolean
  withdrawalAccepted        Boolean
  dataConsentAccepted       Boolean
  giftDelivery              String?
  giftSubscriptionDuration  GiftSubscriptionDuration?
  isNew                     Boolean                   @default(true)
  promoGiftRecipientCity    String?
  promoGiftRecipientCountry String?
  promoGiftRecipientEmail   String?
  promoGiftRecipientName    String?
  promoGiftRecipientStreet  String?
  promoGiftRecipientZip     String?
  gift                      Gift?                     @relation(fields: [giftId], references: [id])

  @@index([giftId], map: "Subscription_giftId_fkey")
}

model Gift {
  id             String         @id @default(cuid())
  name           String
  description    String?        @db.Text
  imageUrl       String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  descriptionES  String?        @db.Text
  isTranslatedES Boolean        @default(false)
  nameES         String?
  subtitle       String?
  subtitleES     String?
  subscriptions  Subscription[]
}

model Beitragstyp {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  nameES    String?
  articles  Article[]
  subtypes  Beitragssubtyp[]
  carousels Carousel[]
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  parentId  Int?
  nameES    String?
  carousels Carousel[]
  parent    Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children  Region[]   @relation("RegionHierarchy")
  articles  Article[]  @relation("ArticleRegions")
  authors   Author[]   @relation("AuthorRegions")
  editions  Edition[]  @relation("EditionRegions")

  @@index([parentId], map: "Region_parentId_fkey")
}

model Topic {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  parentId Int?
  nameES   String?
  parent   Topic?    @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[]   @relation("TopicHierarchy")
  articles Article[] @relation("ArticleTopics")
  authors  Author[]  @relation("AuthorTopics")
  editions Edition[] @relation("EditionTopics")

  @@index([parentId], map: "Topic_parentId_fkey")
}

model Beitragssubtyp {
  id            Int         @id @default(autoincrement())
  name          String
  beitragstypId Int
  articles      Article[]
  beitragstyp   Beitragstyp @relation(fields: [beitragstypId], references: [id])

  @@unique([name, beitragstypId])
  @@index([beitragstypId], map: "Beitragssubtyp_beitragstypId_fkey")
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  username             String?          @unique
  email                String?          @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  password             String
  role                 Role             @default(user)
  canTranslate         Boolean          @default(false)
  language             String           @default("de")
  accounts             Account?
  pdfAboInvitation  PdfAboInvitation?
  activityLogs         ActivityLog[]
  aktuelles            Aktuelles[]
  reviewsAssigned      Article[]        @relation("ArticleReviewer")
  translationsAssigned Article[]        @relation("ArticleTranslator")
  editionsTranslated   Edition[]        @relation("EditionTranslator")
  favorites            Favorite[]
  sessions             Session[]
  tocManualMatches     TocManualMatch[]
}

model Account {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model InvitationToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Author {
  id               Int             @id @default(autoincrement())
  name             String          @unique(map: "name")
  email            String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bio              String?         @db.Text
  location         String?
  role             String?
  personCategoryId Int?
  drupalId         Int?            @unique
  personCategory   PersonCategory? @relation("AuthorPersonCategory", fields: [personCategoryId], references: [id])
  articles         Article[]       @relation("ArticleAuthors")
  regions          Region[]        @relation("AuthorRegions")
  topics           Topic[]         @relation("AuthorTopics")

  @@index([personCategoryId], map: "Author_personCategoryId_fkey")
}

model PersonCategory {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  authors Author[] @relation("AuthorPersonCategory")

  @@map("PersonCategory")
}

model ObituaryDetails {
  id                Int     @id @default(autoincrement())
  articleId         Int     @unique
  deceasedFirstName String
  deceasedLastName  String
  dateOfBirth       Int
  dateOfDeath       Int
  notes             String?
  article           Article @relation(fields: [articleId], references: [id])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  nameES    String?
  articles  Article[]  @relation("ArticleCategories")
  carousels Carousel[] @relation("CarouselCategories")
}

model Image {
  id          Int      @id @default(autoincrement())
  contentType String
  contentId   Int
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alt         String?
  title       String?  @db.VarChar(750)
  height      Int?
  width       Int?
  altES       String?
  titleES     String?  @db.VarChar(750)

  @@index([contentType, contentId])
}

model Favorite {
  id        Int     @id @default(autoincrement())
  userId    String
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId], map: "Favorite_articleId_fkey")
}
model NetworkPartner {
  id          String   @id @default(cuid())
  name        String
  nameEs      String?  // Nombre en español (si es diferente)
  description String?  @db.Text
  descriptionEs String? @db.Text
  url         String
  logoUrl     String?  // URL del logo en Cloudinary
  logoWidth  Int?
  logoHeight Int?
  order       Int      @default(0) // Para ordenar manualmente
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("network_partners")
}
model Event {
  id            String   @id @default(uuid())
  title         String
  description   String   @db.Text
  date          DateTime
  location      String
  image         String
  createdAt     DateTime @default(now())
  time          String?
  descriptionES String?  @db.Text
  titleES       String?
}

model ActivityLog {
  id         Int            @id @default(autoincrement())
  userId     String
  articleId  Int?
  action     ActivityAction
  createdAt  DateTime       @default(now())
  carouselId String?
  metadata   String?        @db.LongText
  editionId  Int?
  article    Article?       @relation(fields: [articleId], references: [id])
  carousel   Carousel?      @relation("CarouselToActivityLogs", fields: [carouselId], references: [id])
  edition    Edition?       @relation(fields: [editionId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([articleId])
  @@index([carouselId])
  @@index([editionId], map: "ActivityLog_editionId_fkey")
}

model Carousel {
  id            String            @id @default(cuid())
  beitragstypId Int?
  topic         String?
  limit         Int               @default(10)
  orderBy       String            @default("date_desc")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  titleDE       String?
  titleES       String?
  regionId      Int?
  position      Int               @default(0)
   placement     String            @default("after")
  isManual      Boolean           @default(false)
  isPrimary     Boolean           @default(false)
  carouselType  String            @default("horizontal")
  activityLogs  ActivityLog[]     @relation("CarouselToActivityLogs")
  beitragstyp   Beitragstyp?      @relation(fields: [beitragstypId], references: [id])
  region        Region?           @relation(fields: [regionId], references: [id])
  articles      CarouselArticle[]
  categories    Category[]        @relation("CarouselCategories")

  @@index([beitragstypId], map: "Carousel_beitragstypId_fkey")
  @@index([regionId], map: "Carousel_regionId_fkey")
}

model TocManualMatch {
  id        Int      @id @default(autoincrement())
  editionId Int
  tocTitle  String   @db.VarChar(500)
  articleId Int
  createdAt DateTime @default(now())
  createdBy String?
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator   User?    @relation(fields: [createdBy], references: [id])
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, tocTitle])
  @@index([editionId])
  @@index([articleId])
  @@index([createdBy], map: "TocManualMatch_createdBy_fkey")
}

model CarouselArticle {
  id         String   @id @default(cuid())
  carouselId String
  articleId  Int
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)

  @@unique([carouselId, articleId])
  @@index([carouselId])
  @@index([articleId])
}

enum GiftSubscriptionDuration {
  ONE_YEAR
  UNTIL_CANCELLED
}

enum SubscriptionType {
  NORMAL
  NORMAL_PDF
  SUPPORTER
  REDUCED
  TRIAL
}

enum SubscriptionFormat {
  PRINT
  PDF
}

enum Role {
  user
  admin
  translator
  reviewer
  k2
}

enum ActivityAction {
  TRANSLATE_ARTICLE
  CREATE_ARTICLE
  UPDATE_ARTICLE
  DELETE_ARTICLE
  CREATE_EDITION
  CREATE_EVENT
  REVIEW_TRANSLATION
  CREATE_CAROUSEL
  DELETE_CAROUSEL
  TRANSLATE_EDITION
  SUBMIT_TRANSLATION
  ASSIGN_TRANSLATOR
}
